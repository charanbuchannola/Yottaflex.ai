# YottaFlex Logistics Configuration Template
# Copy to .env for local runtime overrides

# Default PRNG Seed (Deterministic)
LOGISTICS_SEED=20261022

# Dataset Profile: STARTER or FULL
LOGISTICS_PROFILE=STARTER

# Database Connection (SQLite local file)
LOGISTICS_DATABASE_URL=sqlite:///data/logistics.db

# Simulation Timeline Configuration
LOGISTICS_SIMULATION_START=2026-10-22T00:00:00Z
LOGISTICS_SIMULATION_DAYS=7

# Directory Paths
LOGISTICS_DATA_DIR=data
LOGISTICS_EXPORTS_DIR=exports

# API Server Configuration
LOGISTICS_API_HOST=127.0.0.1
LOGISTICS_API_PORT=8000
